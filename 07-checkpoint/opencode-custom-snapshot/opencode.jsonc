  "instructions": [
    "~/.config/opencode/instructions/auto-mode.md",
    "~/.config/opencode/MEMORY.md",
    "~/.config/opencode/instructions/search-behavior.md"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skill/browser-harness",
      "~/.config/opencode/skills",
      "/home/zako-mio/.config/opencode/skills"
    ]
  },
  "permission": {
    "pdf-reader_*": "deny",
    "drawio_*": "deny",
    "vscode-mcp-server_*": "deny",

    // 读：全盘可读（工作区外边界放行），敏感凭证目录末条 deny
    // external_directory 匹配串 = 绝对父目录 + "/*"；宽规则在前、窄规则在后（末条匹配胜出）
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny"
    },

    // 读补充：仅追加 opencode auth.json 拒绝（.env 沿用引擎默认，不额外收紧）
    // 写（edit）分层不放在全局：全局 user 规则排在 plan/explore 内置 edit deny 之后会覆盖它们，
    // 故 edit 分层只放在 agent.build.permission（执行型主 Agent）与 5 个写入型子Agent。
    "read": {
      "home/zako-mio/.local/share/opencode/auth.json": "deny"
    },

    "bash": {
      "python -c *": "deny",
      "*Set-Content*": "ask",
      "*Out-File*": "ask",
      "*Remove-Item* -Force*": "ask",
      "rm -rf *": "deny",
      "git push *": "deny"
    }
  },
  "mcp": {
    "vscode-mcp-server": {
      "type": "local",
      "command": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "/home/zako-mio/.config/opencode/vscode-mcp-launcher.ps1"
      ],
      "enabled": false,
      "description": "【已禁用】仅 6 个工具(~692 tokens) 极少使用。审计报告见 Mission-file\\2026-08\\0802-vscode-mcp-server-tools-audit\\vscode-mcp-server-tools-audit.md"
    },
    "amap": {
      "type": "local",
      "command": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "/home/zako-mio/.config/opencode/amap-mcp-wrapper.ps1"
      ],
      "enabled": false,
      "description": "【已禁用】12 个工具 ~2000 tokens 极低频"
    },
    "pdf-reader": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sylphx/pdf-reader-mcp@latest"
      ],
      "enabled": true,
      "description": "【启用】PDF 文本提取。仅 pdf-worker 子Agent 使用（4 工具）"
    },
    "drawio": {
      "type": "local",
      "command": [
        "node",
        "/mnt/d/Opencode/drawio-mcp-minimal/package/src/index.js"
      ],
      "enabled": true,
      "description": "【启用】draw.io 图表创建（本地精简版 v1.5.0）。仅 drawio-worker 子Agent 使用"
    },
    "drawio-local": {
      "type": "local",
      "command": [
        "node",
        "/mnt/d/Opencode/drawio-mcp-minimal/package/src/index.js"
      ],
      "enabled": false,
      "description": "【禁用·离线兜底】断网时启用，与主 drawio 同一实例",
      "environment": {
        "DRAWIO_BASE_URL": "http://localhost:8080/"
      }
    },
    "headroom": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "/home/zako-mio/.config/opencode/headroom-mcp-launcher.ps1"
      ],
      "enabled": false,  // 0812 量化亏损禁用；CLI 仍可用（headroom proxy/audit-reads/savings）
      "description": "【已禁用 2026-08-12】量化亏损（工具开销 > 收益）。切 Claude Code/Codex 走 proxy 时改回 true。CLI 仍可用"
    }
  }
}