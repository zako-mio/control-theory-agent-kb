          "name": "DeepSeek V4 Flash (Go)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
