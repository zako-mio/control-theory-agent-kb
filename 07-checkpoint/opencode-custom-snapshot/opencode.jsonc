          "modalities": { "input": ["text"], "output": ["text"] },
          "attachment": false,     // Command Code caps.vision=false
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "limit": { "context": 256000, "output": 32768 },      // models.dev vercel 同 id 记录一致
          "cost": { "input": 0, "output": 0, "cache_read": 0 },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        },
        "inclusionai/ling-3.0-flash-sante:free": {
          "name": "Ling 3.0 Flash Sante ★免费·100次/天",
          "modalities": { "input": ["text"], "output": ["text"] },
          "attachment": false,
          "reasoning": true,
          "tool_call": true,       // 实测：返回 tool_calls
          "temperature": false,
          "limit": { "context": 262144, "output": 32768 },      // models.dev openrouter / kilo 同 id 记录一致
          "cost": { "input": 0, "output": 0, "cache_read": 0 },
          "variants": {
