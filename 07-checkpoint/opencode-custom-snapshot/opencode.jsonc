  "instructions": [
    "~/.config/opencode/instructions/auto-mode.md",
    "~/.config/opencode/MEMORY.md",
    "~/.config/opencode/instructions/search-behavior.md",
    "~/.config/opencode/instructions/architecture-behavior.md",
    "~/.config/opencode/instructions/requirement-discovery-behavior.md",   // 0921 (ii)：需求发现行为层（全局注入但**压紧 ≤22 行**；定档前置 K1–K5＋M1，简单档不加载/不委派/不产工件）
    "~/.config/opencode/instructions/browser-management.md"   // 0914 G-08：注册（原未注册却被 agent-protocol 内联复述；已删内联，本文件为唯一真相源）
  ],
  // 0911: skill 双根已统一到 skills/。两个根本就在 opencode 默认扫描 glob `{skill,skills}/**/SKILL.md`
  // 内（见 opencode 二进制 SA 常量 + opencode-config/ref/skills.md 第4步），故原 skills.paths 3 条全部冗余，已整体移除。
  // 0914 G-09: 单数根 skill/ 此前仅残留一份重复的 agency-agents/agent-index.json（幽灵根），已连同空目录一并归档清除
  // （wave0/retired-skill-root/）；此后仅保留复数根 skills/，search-agents.py 缓存路径已指向 skills/agency-agents/。
  "permission": {
    "pdf-reader_*": "deny",
    // 0914 G-23：保留（不删）。vscode-mcp-server 当前 enabled:false，此 deny 为「re-enable 前置防御」——
    //   一旦重新启用该 MCP，其工具默认即被拒绝；删除会使 re-enable 后工具面裸奔。属死配置但有意保留。
    "vscode-mcp-server_*": "deny",

    // 0914 G-01：MEMORY.md 全局兜底 deny。G-21 实测合并序 = [builtin, 全局, agent]，agent 级末条胜出；
    //   故 build 保留 agent 级 allow（/reflection 唯一合法写入路径），其余 agent 无 MEMORY allow → 命中此 deny。
    "edit": {
      "home/zako-mio/.config/opencode/MEMORY.md": "deny"
    },

    // 读：全盘可读（工作区外边界放行），敏感凭证目录末条 deny
    // external_directory 匹配串 = 绝对父目录 + "/*"；宽规则在前、窄规则在后（末条匹配胜出）
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny"
    },

    // 读补充：追加 opencode auth.json 与 opencode.env 拒绝（G-02：env 文件含明文 provider key，显式 deny）
    // 写（edit）分层不放在全局：全局 user 规则排在 plan/explore 内置 edit deny 之后会覆盖它们，
    // 故 edit 分层只放在 agent.build.permission（执行型主 Agent）与 5 个写入型子Agent。
    "read": {
      "home/zako-mio/.local/share/opencode/auth.json": "deny",
      "home/zako-mio/.config/opencode/opencode.env": "deny"
    },

    "bash": {
      "python -c *": "deny",
      "*Set-Content*": "ask",
      "*Out-File*": "ask",
      "*Remove-Item* -Force*": "ask",
      "rm -rf *": "deny",
      "git push *": "deny",
      // 0914 G-36：`opencode debug config` 会批量输出 provider 明文 apiKey（实测 3 处）。ask 阻断静默泄露，
      // 保留人工确认后的排障能力；`opencode debug agent` 等其它子命令不受影响（G-21 仍可用）。
      "opencode debug config*": "ask"
    }
  },
  "mcp": {
    "vscode-mcp-server": {
      "type": "local",
      "command": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "/home/zako-mio/.config/opencode/vscode-mcp-launcher.ps1"
      ],
      // 0914 G-12 停用原因：工具面小（6 工具 ~692 tokens）且极少使用，性价比低
      "enabled": false,
      "description": "【已禁用】仅 6 个工具(~692 tokens) 极少使用。审计报告见 Mission-file\\2026-08\\0802-vscode-mcp-server-tools-audit\\vscode-mcp-server-tools-audit.md"
    },
    "amap": {
      "type": "local",
      "command": [
        "powershell",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "/home/zako-mio/.config/opencode/amap-mcp-wrapper.ps1"
      ],
      // 0914 G-12 停用原因：12 工具 ~2000 tokens 且调用频率极低；随同 3 个 amap 软停用 skill 一并停用
      "enabled": false,
      "description": "【已禁用】12 个工具 ~2000 tokens 极低频"
    },
    "pdf-reader": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sylphx/pdf-reader-mcp@latest"
      ],
      "enabled": true,
      "description": "【启用】PDF 文本提取。仅 pdf-worker 子Agent 使用（4 工具）"
    },
    "headroom": {
      "type": "local",
      "command": [
        "powershell",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "/home/zako-mio/.config/opencode/headroom-mcp-launcher.ps1"
      ],
      // 0914 G-12 停用原因：量化亏损（工具开销 > 收益），2026-08-12 起禁用；切 Claude Code/Codex 走 proxy 时改回 true（CLI 仍可用）
      "enabled": false,
      "description": "【已禁用 2026-08-12】量化亏损（工具开销 > 收益）。切 Claude Code/Codex 走 proxy 时改回 true。CLI 仍可用"
    }
  }
}