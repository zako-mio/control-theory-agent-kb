    "zhipu": {
      "npm": "@ai-sdk/openai-compatible",       // 智谱官方 SDK 不可用，走 OpenAI 兼容协议（复刻 opencode-go 模板）
      "name": "Zhipu GLM",
      "description": "智谱 AI 官方 API（apiKey 从 ZHIPU_API_KEY 环境变量读取）。提供 glm-5.3-flash（编码）与 glm-4.6v（视觉，可 /models 手动切换）",
      "options": {
        "baseURL": "https://open.bigmodel.cn/api/paas/v4",  // SDK 自动拼 /chat/completions（勿写完整路径否则 404）
        "apiKey": "{env:ZHIPU_API_KEY}",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 60000
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash (智谱官方)",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 1.25,
            "output": 4.2,
            "cache_read": 0.2
          },
          "variants": {
            "daily": {
              "options": {
                "thinking": { "type": "enabled" },
                "reasoning_effort": "high",
                "max_tokens": 32768
              }
            },
            "deep": {
              "options": {
                "thinking": { "type": "enabled" },
                "reasoning_effort": "max",
                "max_tokens": 65536
              }
            }
          }
        },
        "glm-4.6v": {
          "name": "GLM-4.6V (智谱官方视觉)",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 1.8,
            "output": 5.5,
            "cache_read": 0.3
          },
          "variants": {
            "daily": {
              "options": {
                "max_tokens": 8192
              }
            },
            "deep": {
              "options": {
                "max_tokens": 16384
              }
            }
          }
        }
      }
    }
