{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",   // 顶层默认模型：官方直连 V4.1 Flash 正式版（0910 起；原生多模态；plan/build 各自覆盖）
  "small_model": "deepseek/deepseek-flash",
  "subagent_depth": 1,                     // 0915：由 2 降回 1。depth=2 的唯一用途（worker 再委派视觉子 Agent 代看图片）已随视觉子 Agent 废除而消失，现无任何子 Agent 持有 task 权限
  "compaction": {
    "auto": true,                    // 自动压缩
    "prune": true,                   // 裁剪旧工具输出
    "tail_turns": 4,                 // 保留最近 4 个用户回合
    "preserve_recent_tokens": 16384, // 尾回合 token 预算
    "reserved": 10000                // 预留缓冲
  },
  "agent": {
    "plan": {
      "variant": "daily",   // 0914 G-18：保留——auto-mode 刚性规则#5 禁改 agent.plan/build 的 variant 配置；daily=variants[0] 默认档
      // 0914 G-18：model 删去改继承顶层 model（deepseek/deepseek-flash）；解析值不变（input.model ?? currentModel 默认=顶层）
      "prompt": "# Plan Mode 协议\n\nPlan 模式默认逐题访谈：一次一问，每条消息末尾必须带一次 `question` 工具调用（决策树收敛汇总那一条除外）；能由代码库或文件自答的分支先自行探索，不反问用户；所有分支收敛后给出决议汇总，并输出 `[COMPLEXITY: X/20]`。所有对外文案使用用户当前会话语言。完整逐题访谈协议、措辞语言规则与漂移护栏见 `skills/grill-me/SKILL.md`。\n\n任务调度与委派执行协议统一收敛到 `instructions/agent-protocol.md`：**开始任务前必须先读取该文件，读取前不得执行任何委派**；委派流程 5 步、MCP 路由与视觉降级、编码安全、Mission 留档与 5 段报告、浏览器标签页管理、Variant 继承规则、Reflection 指针均以该文件为准，本会话须严格执行。Plan 阶段只收敛方案与决策，不执行多步写操作；确需只读探索时可用 read/grep/glob，任务分类与复杂度门控按 auto-mode.md 执行。\n",
      "permission": {
        "bash": {
          "*": "deny",
          "git status *": "allow",
          "git diff *": "allow",
          "Get-ChildItem *": "allow"
        }
      }
    },
    "build": {
      "variant": "daily",   // 0914 G-18：保留——auto-mode 刚性规则#5 禁改 agent.plan/build 的 variant 配置；daily=variants[0] 默认档
      // 0914 G-18：model 删去改继承顶层 model（deepseek/deepseek-flash）；解析值不变（input.model ?? currentModel 默认=顶层）
      // edit 分层只读：放 agent.build 而非全局（全局 user 规则会覆盖 plan/explore 的内置 edit deny）
      // edit 覆盖 edit/write/apply_patch；匹配串 = 相对 worktree 路径（本项目非 git，worktree="/" 故无前导斜杠）
      "permission": {
        "edit": {
          "*": "ask",
          "home/zako-mio/opencode/**": "allow",
          "tmp/opencode/**": "allow",
          "mnt/d/Opencode_Download/**": "allow",
          "home/zako-mio/.config/opencode/MEMORY.md": "allow"
        }
      },
      "prompt": "# Agent Protocol\n\n完整 Agent Protocol 见 `instructions/agent-protocol.md`：**开始任务前必须先读取该文件，读取前不得执行任何委派**，必须遵守。\n"
    },
    "pdf-worker": {
      "description": "PDF reader, OCR, and document analysis specialist. Use for any task involving PDF files.",
      "mode": "subagent",
      "hidden": true,
      // 0826 解除视觉模型绑定（0822 曾绑定 vision-exp）：继承父会话模型；假定无视觉能力，
      // PDF 走文本提取/OCR 文本链路；图片理解由会话模型原生视觉直接 Read，无视觉则人看（0915：代看子 Agent 已废除）
      "permission": {
        "pdf-reader_*": "allow",
        // 子Agent 不继承父 session 的 edit ask/allow（只继承 external_directory + deny），故逐 agent 复制分层
        // 0914 G-01：不授予 MEMORY.md 写权限（全局 deny 兜底）；记忆写入经 pending.json → /reflection(build) 链路
        "edit": {
          "*": "ask",
          "home/zako-mio/opencode/**": "allow",
          "tmp/opencode/**": "allow",
          "mnt/d/Opencode_Download/**": "allow"
        }
      }
    },
    "architect-worker": {
      "description": "架构判断与设计裁决专家。技术选型/架构风格/模块与服务边界/架构评审/质量属性权衡/技术债治理时委派。产出 ADR 与多维权衡矩阵，并经 gate_architecture.py 门控。",
      "mode": "subagent",
      "hidden": false,            // 0911 新增：可见子Agent（可 @ 召唤 + 主Agent 自动委派）
      // 0911 不配 model → 继承父会话模型（与 pdf-worker 0826 起的继承制一致）
      "permission": {
        // 职责单一：不含制图，故不自委派（架构图由主 Agent 按 diagram-lite 档位出图）
        "task": { "*": "deny" },
        "bash": {
          "*": "deny",
          "git status *": "allow",
          "git diff *": "allow",
          // 0916 D-01：「打通生产者-验证者」——workflow.md 第 4 步要求跑门控自检，
          // 但原先 bash 仅 git status/diff → 生产者跑不了自己的门控，必须主 Agent 代跑（多一轮往返）。
          // 此处只放行门控脚本本身（`*` 跨斜杠全串匹配，末条命中优先）。
          "python3 *gate_architecture.py*": "allow"
        },
        // 子Agent 不继承父 session 的 edit ask/allow（只继承 external_directory + deny），故逐 agent 复制分层
        "edit": {
          "*": "ask",
          "home/zako-mio/opencode/**": "allow",
          "tmp/opencode/**": "allow"
        }
      }
    },
    "general": {
      "description": "General-purpose agent for researching complex questions and executing multi-step tasks. Inherits parent session model.",
      "permission": {
        // 子Agent 不继承父 session 的 edit ask/allow（只继承 external_directory + deny），故逐 agent 复制分层
        // 0914 G-01：不授予 MEMORY.md 写权限（全局 deny 兜底）；记忆写入经 pending.json → /reflection(build) 链路
        "edit": {
          "*": "ask",
          "home/zako-mio/opencode/**": "allow",
          "tmp/opencode/**": "allow",
          "mnt/d/Opencode_Download/**": "allow"
        }
      }
    },
    "explore": {
      "description": "Fast agent specialized for exploring codebases. Inherits parent session model."
    },
    "reflection-worker": {
      "description": "Reflection specialist for the self-evolution system. Analyzes Plan+Build cycles and generates Memory/Skill entries. Use ONLY for asynchronous post-cycle reflection tasks.",
      "mode": "subagent",
      "hidden": true,
      "permission": {
        "bash": {
          "*": "deny"
        },
        // 子Agent 不继承父 session 的 edit ask/allow（只继承 external_directory + deny），故逐 agent 复制分层
        // 0914 G-01：不授予 MEMORY.md 写权限（全局 deny 兜底）；记忆写入经 pending.json → /reflection(build) 链路
        "edit": {
          "*": "ask",
          "home/zako-mio/opencode/**": "allow",
          "tmp/opencode/**": "allow",
          "mnt/d/Opencode_Download/**": "allow"
        }
      }
    },
    "search-worker": {
      "description": "搜索管线执行 Agent。只做搜索管线(发现+获取+交叉验证)，输出结构化证据包。Use for any task requiring external search, query disambiguation, multi-source fact-checking, or evidence-pack construction.",
      "mode": "subagent",
      "hidden": true,
      // 继承父会话模型（与 pdf-worker 0826 趋势一致），不绑定视觉模型
      "permission": {
        // 子Agent 不继承父 session 的 edit ask/allow（只继承 external_directory + deny），故逐 agent 复制分层
        // 0914 G-01：不授予 MEMORY.md 写权限（全局 deny 兜底）；记忆写入经 pending.json → /reflection(build) 链路
        "edit": {
          "*": "ask",
          "home/zako-mio/opencode/**": "allow",
          "tmp/opencode/**": "allow",
          "mnt/d/Opencode_Download/**": "allow"
        }
      }
    },
    "requirement-discovery-worker": {
      // 0921 (ii)：需求发现三层栈的**子 Agent**。Skill=requirement-discovery，行为层=requirement-discovery-behavior.md
      "description": "需求发现与澄清专家（需求层·内部意图固化）。需求表述模糊、含互斥走法、可行性未知或需按产品设计复杂度走一遍时委派。产出 POV／HMW／product outcome／appetite／最小交接契约，并经 gate_requirement_discovery.py 门控。",
      "mode": "subagent",
      "hidden": false,            // 可见子Agent（可 @ 召唤 + 主Agent 自动委派），与 architect-worker 一致
      // 不配 model → 继承父会话模型（与 architect-worker 0911 起的继承制一致）
      "permission": {
        "task": { "*": "deny" },  // 职责单一：不含制图，故不自委派（原型/流程出图由主 Agent 按 diagram-lite 档位出图）
        "bash": {
          "*": "deny",
          "git status *": "allow",
          "git diff *": "allow",
          // 0916 D-01 范式：打通生产者-验证者——只放行门控脚本本身，使产出方能自跑门控并回传输出原文
          "python3 *gate_requirement_discovery.py*": "allow"
        },
        // 子Agent 不继承父 session 的 edit ask/allow（只继承 external_directory + deny），故逐 agent 复制分层
        "edit": {
          "*": "ask",
          "home/zako-mio/opencode/**": "allow",
          "tmp/opencode/**": "allow"
        }
      }
    }
  },
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",       // Go 套餐走 OpenAI 兼容协议（chat/completions）
      "name": "OpenCode Go",
      "description": "OpenCode Go 订阅套餐（$10/月，$60 额度）。DeepSeek Flash 包月 3x 额度；GLM/Kimi/Qwen 高性价比编码模型。apiKey 从 OPENCODE_GO_API_KEY 环境变量读取",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",  // SDK 自动拼 /chat/completions（勿写完整路径否则 404）
        "apiKey": "{env:OPENCODE_GO_API_KEY}",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 300000
      },
      "blacklist": [
        "deepseek-v4-pro",   // Pro 禁用 Go，仅官方直连（用户要求）
        "grok-4.5",          // $15 额度仅 ~600 req/月，不值
        "gpt-5.6-luna",      // 5.6 系低配 + $15 额度小
        "muse-spark-1.2-contributor"  // 数据用于 Meta 训练，涉仓库代码慎用
      ],
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (Go)",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 0.22,
            "output": 0.66,
            "cache_read": 0.007
          },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        },
        "glm-5.2": {
          "name": "GLM-5.2 (Go)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 1.4,
            "output": 4.4,
            "cache_read": 0.26
          },
          "variants": {
            "daily": { "thinking": { "type": "enabled" }, "reasoningEffort": "high" },
            "deep": { "thinking": { "type": "enabled" }, "reasoningEffort": "max" }
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code (Go)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 0.95,
            "output": 4.0,
            "cache_read": 0.19
          },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus (Go)",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 0.4,
            "output": 1.6,
            "cache_read": 0.04
          },
          "variants": {
            "daily": { "enable_thinking": true, "reasoningEffort": "high" },
            "deep": { "enable_thinking": true, "reasoningEffort": "max" }
          }
        }
      }
    },
    "opencode-go-tmp": {
      // ===== 2026-10-10 新建（临时）：独立承载「临时 Go 套餐 key」=====
      // ⛔ 与上方 opencode-go（长期 key）凭据完全不同，不覆盖、不复用 OPENCODE_GO_API_KEY，两 provider 互不影响。
      // ⚠ 有效期 5 天 → 到期日 2026-10-15。到期后整套删除：本段 + opencode.env 的 OPENCODE_GO_TMP_API_KEY 行
      //    （留档见 opencode.jsonc.bak-20261010-tmpgo / opencode.env.bak-20261010-tmpgo）。
      //
      // 网络路径（2026-10-10 实测，3 轮复测）：
      //   · 直连可用且更快 —— *.opencode.ai 已在 no_proxy 白名单：/models ttfb 0.88~0.90s
      //   · 经规则代理 172.29.0.1:7890 亦通（200）但 /models ttfb 5.76s，慢约 6.5x（代理未启动窗口内曾整体超时，属代理侧状态）
      //   ⇒ 本 provider 不配任何代理参数，保持走白名单直连。（代理路径实测吞吐与直连同量级，TTFT 更差）
      //
      // 会话头（硬要求）：网关要求 x-opencode-session，缺失即 400 MissingSessionID（实测无头 400 / 有头 200）。
      //   opencode 1.18.35 仅在 providerID.startsWith("opencode") 时自动注入该头（二进制内实证）
      //   ⇒ provider id 的 "opencode" 前缀为保证可用性的硬约束，勿改名。
      //
      // 模型清单＝用户指定的**仅这两个**。实测该 key 在服务端**未**被限制到这两个模型（glm-5.2 亦返回 200）
      //   ⇒「只这两个模型」由本段本地收敛实现（Go 套餐目录 38 个模型一律不登记）。
      // 元数据来源：models.dev provider `opencode-go`（2026-10-10 取；与网关 /zen/go/v1/models 目录一致）。
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (临时·5天)",
      "description": "OpenCode Go 临时 key（2026-10-15 到期）。仅暴露 DeepSeek V4.1 Flash 与 GLM-5.3 Flash 两个模型。apiKey 从 OPENCODE_GO_TMP_API_KEY 读取，与长期 opencode-go provider 完全独立。实测：直连可用（.opencode.ai 在 no_proxy 白名单），经代理亦通但 TTFT 更差；网关要求 x-opencode-session 头（客户端对 opencode* 前缀 provider 自动注入）",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_TMP_API_KEY}",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 300000
      },
      "models": {
        // 实测 2026-10-10（curl 直连 + x-opencode-session）：reasoning_effort=max + tools → 200，
        //   finish_reason=tool_calls，返回 reasoning_content（与 interleaved.field 一致）。
        // 吞吐（512 tok 流式 ×3 轮，直连）：默认档解码中位 192 tok/s（190~262）、e2e 中位 118 tok/s；
        //   effort=max 档解码中位 249（197~259）、e2e 中位 115；TTFT 1.3~2.8s。
        // ===== 模型 key 与 API 模型名**解耦**（2026-10-10 干净室实测）=====
        // 为什么：会话头只打印 model key（`build · <key>`）、`opencode models` 也只列 key ——
        //   若 key 用真实模型名（glm-5.3-flash），这些面**看不出这是临时 key**，会影响选用判断。
        // 做法：key 加 `-tmp` 后缀（所有显示面自带临时标记），`id` 才是发给 API 的真实模型名。
        // 实测：将 key 改为 glm-5.3-flash-tmp + id=glm-5.3-flash，客户端实跑成功且头打印 `build · glm-5.3-flash-tmp`；
        //   对照实验（直接向 API 发 -tmp 名）→ 400 `Model is unavailable` ⇒ 证明 API 实际收到的是 id 字段值。
        // ⚠ 隐式契约（非文档字段）：opencode 1.18.35 遵从 `id`；若未来版本忽略该字段，调用会静默 400。
        //   升级 opencode 后复验：
        //   curl -s https://opencode.ai/zen/go/v1/chat/completions -H "Authorization: Bearer $KEY" \
        //     -H "x-opencode-session: ses_xxx" -H 'Content-Type: application/json' \
        //     -d '{"model":"glm-5.3-flash","max_tokens":4,"messages":[{"role":"user","content":"hi"}]}'   # 须 200
        "deepseek-v4.1-flash-tmp": {
          "id": "deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash (Go·临时·至10-15)",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 1000000, "output": 384000 },
          "cost": { "input": 0.15, "output": 0.6, "cache_read": 0.003 },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        },
        // 实测 2026-10-10：
        //   ① reasoning_effort=max + tools → 200（tool_calls + reasoning_content）✔
        //   ② ⛔ 禁传 `thinking` 参数：实测 400 invalid_request_error / unknown_parameter: unknown field "thinking"
        //      （对照：同网关 glm-5.2 可容忍该参数 ⇒ 上游不同，勿照抄既有 glm-5.2 段的 variants 写法）
        //   ③ modalities 按仓库惯例收敛为 text+image（models.dev 另记 video/pdf，但全仓 modalities 从无 video/pdf 先例）
        // 吞吐（512 tok 流式 ×3 轮，直连）：默认档解码中位 193 tok/s（126~484）、e2e 中位 134；
        //   ⚠ effort=max 档抖动极大（解码 30~145，e2e 26~108）；TTFT 1.1~2.5s。
        "glm-5.3-flash-tmp": {
          "id": "glm-5.3-flash",
          "name": "GLM-5.3 Flash (Go·临时·至10-15)",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 1000000, "output": 131072 },
          "cost": { "input": 0.15, "output": 0.5, "cache_read": 0.03 },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",   // 0908 从 @ai-sdk/deepseek 换为 openai-compatible：官方 SDK 丢弃图片 part（仅处理 text，其余推 unsupported warnings），导致 Read 图片无法到达模型
      "name": "DeepSeek",
      "description": "DeepSeek 官方 API（经 @ai-sdk/openai-compatible 协议接入）。缓存监控已稳定启用",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 300000
      },
      "blacklist": [
        "deepseek-v4-flash",             // 0910：flash 线已统一为 deepseek-flash，屏蔽 models.dev 注册表旧条目
        "deepseek-v4-flash-vision-exp",  // 0910：视觉实验版已被原生多模态 deepseek-flash 取代
        "deepseek-v4-pro"                // 0910：官方 09-14 12:00 下线并路由到 V4.1 Flash
      ],
      "models": {
        "deepseek-flash": {
