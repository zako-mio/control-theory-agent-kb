            "input": 0.14,
            "output": 0.56,
            "cache_read": 0.0028,
            "cache_write": 0.14
          },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        }
      }
