    "commandcode-free": {
      // 2026-09-27 拆出：本 provider 专用「新 key 账户」，与上方 commandcode（旧 key 账户）
      //   凭据不同、不可混用，故独立 provider 承载。免费模型 0 credit，不消耗任何账户额度。
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code Free",
      "description": "Command Code 免费模型（独立 key：COMMANDCODE_FREE_API_KEY）。⚠ 必须经代理（同 commandcode）。⚠ stealth 系是匿名第三方 provider 的隐身预览：官方明示可能留存 prompt/completion 且不提供 ZDR（零数据留存），勿投喂敏感代码/密钥；预览可能随时下线",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1",
        "apiKey": "{env:COMMANDCODE_FREE_API_KEY}",
        "timeout": 300000,
        "headerTimeout": 120000,
        "chunkTimeout": 300000
      },
      "models": {
        // 判据（可机检）：commandcode.ai/docs/resources/pricing-limits 页内置模型数据集，取
        //   rows[].tiers[0].rates 的 input/output/cacheRead 三项全为 0 且 deal.free=true 者。
        //   另两条 free 记录 ling-3.0-flash-free（2026-08-02 到期，标 deprecated）、
        //   typesafe/jev（2026-09-24 到期）已排除。
        // 4 条均以本 provider 的 key（COMMANDCODE_FREE_API_KEY）实测 POST /chat/completions 返回 200，
        //   含带 tools 的工具调用一次。
        // ⚠ stealth 系是匿名第三方提供商运营的「隐身预览」：官方明示该 provider「可能留存
        //   prompt 与 completion，且不提供 ZDR（零数据留存）」。勿向其投喂敏感代码/密钥/内网
        //   信息；且预览可能随时变更或下线（失效时用 /models 换模型）。
        "stealth/space-bunny-alpha": {
          "name": "Space Bunny Alpha ★免费·隐身预览",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,       // 实测：返回 tool_calls（finish_reason=tool_calls）
          "temperature": false,
          "limit": { "context": 1000000, "output": 524288 },   // models.dev 三家独立 provider（nano-gpt / kilo / openrouter）记录一致
          "cost": { "input": 0, "output": 0, "cache_read": 0 },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        },
        "stealth/pixel-canary": {
          "name": "Pixel Canary ★免费·隐身预览",
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "attachment": true,
          "reasoning": true,
          "tool_call": true,       // 实测：返回 tool_calls
          "temperature": false,
          // 上下文取自 Command Code 官方（262K）；官方未公布输出上限，故取「同 262K 上下文的免费
          // 预览模型」通行值 32768（models.dev 对 ling-3.0-flash-sante:free / laguna-s-2.1:free 等
          // 多家记录一致），实测 API 接受 ≥131072，取小值以给输入留出上下文预算
          "limit": { "context": 262144, "output": 32768 },
          "cost": { "input": 0, "output": 0, "cache_read": 0 },
          "variants": {
            "daily": { "reasoningEffort": "high" },
            "deep": { "reasoningEffort": "max" }
          }
        },
        "poolside/laguna-s-2.1-free": {
