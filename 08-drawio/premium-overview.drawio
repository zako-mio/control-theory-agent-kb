        <mxCell id="leg1" value="&lt;b&gt;分层&lt;/b&gt;：&lt;font color=#1F7A52&gt;■ 真·开箱即用 ≥4.5&lt;/font&gt; ｜ &lt;font color=#C77700&gt;■ 成品化受限 3.5–4.5&lt;/font&gt; ｜ &lt;font color=#B23A2F&gt;■ 需装修 / 中转 &lt;3.5&lt;/font&gt;　　&lt;b&gt;标签&lt;/b&gt;：&lt;font color=#1E5AA8&gt;■ 一手&lt;/font&gt; ｜ &lt;font color=#B23A2F&gt;■ 二手&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="1012" width="1440" height="24" as="geometry"/></mxCell>
