        <mxCell id="h0" value="&lt;b&gt;五环&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#ffffff;fillColor=#34495e;strokeColor=#2c3e50;" vertex="1" parent="r0">
          <mxGeometry width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;核心控制概念 → Agent 实现要点&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#ffffff;fillColor=#34495e;strokeColor=#2c3e50;" vertex="1" parent="r0">
